{
  "name": "@naaive/forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forge — a coding agent harness on top of langchain.createAgent. Real-disk filesystem tools, persistent shell, ripgrep grep, plan/permission modes, hooks, system reminders, settings, slash commands.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools/index.ts",
    "./middleware": "./src/middleware/index.ts",
    "./settings": "./src/settings.ts",
    "./prompt": "./src/prompt.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:all": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.81.0",
    "@langchain/anthropic": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "langchain": "^1.0.0",
    "yaml": "^2.8.3",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@langchain/mcp-adapters": "^0.5.0"
  },
  "peerDependenciesMeta": {
    "@langchain/mcp-adapters": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
